{
  "name": "nextjs-mikro-orm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "orm": "mikro-orm",
    "db:create": "mikro-orm database:create",
    "db:drop": "mikro-orm schema:drop --run --drop-migrations-table",
    "db:fresh": "mikro-orm migration:fresh --seed",
    "migration:generate": "mikro-orm migration:create",
    "migration:create": "mikro-orm migration:create --blank",
    "migration:run": "mikro-orm migration:up",
    "migration:revert": "mikro-orm migration:down",
    "migration:status": "mikro-orm migration:list && mikro-orm migration:pending",
    "seed": "mikro-orm seeder:run",
    "seed:static": "mikro-orm seeder:run --class=StaticSeeder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@mikro-orm/seeder": "^7.2.5",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/db/mikro-orm.config.ts"
    ]
  }
}
